      public class Solution extends Relation {
        /**
         * @param n a party with n people
         * @return the celebrity's label or -1
         */
        public int findCelebrity(int n) {
            // Write your code here
            int celeb=0;
            for(int i=1;i<n;i++){
                if(knows(celeb,i)){
                    celeb=i;
                }
            }
            for(int i=0;i<n;i++){
                if(knows(celeb,i) || !knows(i,celeb)){return -1;}
            }
            return celeb;
        }
    }